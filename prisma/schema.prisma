// Prisma schema for Pratisad API

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Minimal M0 Foundation model to verify migrations, database connectivity, and client generation.
// No product or domain models are introduced in Milestone 0.
model HealthCheck {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  @@map("health_checks")
}

// M1: Business Domain Model
// Represents a shop, restaurant, service provider, or other organization using Pratisad.
model Business {
  id                 String               @id @default(uuid())
  name               String
  slug               String               @unique
  description        String?
  localContext       String?              @db.Text
  keywordsRatingLow  String[]             @default([])
  keywordsRatingHigh String[]             @default([])
  logoUrl            String?
  coverImageUrl      String?
  primaryColor       String?
  googleReviewUrl           String?
  googleAutoReplyAllowed    Boolean              @default(false)
  googleAutoReplyEnabled    Boolean              @default(false)
  googleLocationName        String?
  googleLocationTitle       String?
  googleAutoReplySettings   Json?
  isActive                  Boolean              @default(true)
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  member                    BusinessMember?
  feedbackSubmissions       FeedbackSubmission[]
  aiUsageEvents             AiUsageEvent[]
  reviewCards               ReviewCard[]
  googleBusinessConnection  GoogleBusinessConnection?
  googleReviews             GoogleReview[]
  googleOAuthPendingStates  GoogleOAuthPendingState[]

  @@map("businesses")
}

enum GoogleReviewProcessingState {
  synced
  draft_ready
  pending_approval
  queued_post
  posted
  failed
  skipped
}

enum GoogleReviewReplyMode {
  auto
  manual
  approved
}

model GoogleBusinessConnection {
  id                    String    @id @default(uuid())
  businessId            String    @unique
  business              Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  googleAccountEmail    String?
  googleAccountName     String?
  refreshTokenEncrypted String
  accessTokenEncrypted  String?
  accessTokenExpiresAt  DateTime?
  scopes                String?
  tokenVersion          Int       @default(1)
  connectedAt           DateTime  @default(now())
  disconnectedAt        DateTime?
  lastSyncAt            DateTime?
  lastError             String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("google_business_connections")
}

model GoogleOAuthPendingState {
  id          String    @id @default(uuid())
  nonce       String    @unique
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clerkUserId String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([businessId])
  @@map("google_oauth_pending_states")
}

model GoogleReview {
  id                  String                      @id @default(uuid())
  businessId          String
  business            Business                    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  googleReviewName    String                      @unique
  starRating          Int
  comment             String?                     @db.Text
  reviewerDisplayName String?
  reviewCreateTime    DateTime?
  replyComment        String?                     @db.Text
  replyUpdateTime     DateTime?
  draftReplyText      String?                     @db.Text
  processingState     GoogleReviewProcessingState @default(synced)
  syncedAt            DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  replyAttempts       GoogleReviewReplyAttempt[]

  @@index([businessId, processingState])
  @@index([businessId, syncedAt(sort: Desc)])
  @@map("google_reviews")
}

model GoogleReviewReplyAttempt {
  id           String                @id @default(uuid())
  reviewId     String
  review       GoogleReview          @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  attemptedAt  DateTime              @default(now())
  mode         GoogleReviewReplyMode
  draftText    String?               @db.Text
  postedText   String?               @db.Text
  success      Boolean
  errorCode    String?
  errorMessage String?               @db.Text

  @@index([reviewId, attemptedAt(sort: Desc)])
  @@map("google_review_reply_attempts")
}

enum ReviewCardStatus {
  unassigned
  assigned
  revoked
}

model ReviewCardBatch {
  id        String       @id @default(uuid())
  label     String
  quantity  Int
  createdAt DateTime     @default(now())
  cards     ReviewCard[]

  @@map("review_card_batches")
}

model ReviewCard {
  id            String           @id @default(uuid())
  batchId       String
  batch         ReviewCardBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  token         String           @unique
  serialInBatch Int
  businessId    String?
  business      Business?        @relation(fields: [businessId], references: [id], onDelete: SetNull)
  status        ReviewCardStatus @default(unassigned)
  assignedAt    DateTime?
  revokedAt     DateTime?
  lastScannedAt DateTime?
  scanCount     Int              @default(0)
  createdAt     DateTime         @default(now())

  @@index([batchId, status])
  @@index([businessId])
  @@map("review_cards")
}

// Development bootstrap identity only. It is not an authentication mechanism.
model PlatformAdmin {
  id        String   @id @default(uuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_admins")
}

enum BusinessMemberStatus {
  invited
  active
  revoked
}

model BusinessMember {
  id          String               @id @default(uuid())
  businessId  String               @unique
  business    Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  username    String               @unique
  email       String?
  clerkUserId String?
  status      BusinessMemberStatus @default(active)
  invitedAt   DateTime             @default(now())
  acceptedAt  DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([email])
  @@index([clerkUserId])
  @@map("business_members")
}

enum FeedbackSource {
  private_submit
  draft_generated
}

model FeedbackSubmission {
  id         String         @id @default(uuid())
  clientSubmissionId    String?
  submissionFingerprint String?
  businessId            String
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  rating     Int
  keywords   String[]
  comment    String?        @db.Text
  isPrivate  Boolean
  readAt     DateTime?
  source     FeedbackSource
  createdAt  DateTime       @default(now())

  @@index([businessId, createdAt(sort: Desc)])
  @@unique([businessId, clientSubmissionId])
  @@map("feedback_submissions")
}

model AiUsageEvent {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  model      String
  success    Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
  @@map("ai_usage_events")
}
