// Prisma schema for Pratisad API

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Minimal M0 Foundation model to verify migrations, database connectivity, and client generation.
// No product or domain models are introduced in Milestone 0.
model HealthCheck {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  @@map("health_checks")
}

// M1: Business Domain Model
// Represents a shop, restaurant, service provider, or other organization using Pratisad.
model Business {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique
  description     String?
  logoUrl         String?
  coverImageUrl   String?
  primaryColor    String?
  googleReviewUrl String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("businesses")
}

// Development bootstrap identity only. It is not an authentication mechanism.
model PlatformAdmin {
  id        String   @id @default(uuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_admins")
}
