# Copy to .env on the VPS: cp .env.vps.example .env
# Use the same postgres user/password as /root/stack/.env

NODE_ENV=production
PORT=4000
RUN_MIGRATIONS=true

# Frontend origin (comma-separated for extra preview URLs)
CORS_ORIGIN=https://pratisad.scaleopal.com

# Shared postgres container on stack_scaleopal_network (hostname: postgres)
DATABASE_URL=postgresql://postgres:YOUR_STACK_POSTGRES_PASSWORD@postgres:5432/pratisad_db?schema=public

PLATFORM_ADMIN_EMAIL=your-admin@scaleopal.com
CLERK_SECRET_KEY=sk_live_your_clerk_secret

GEMINI_API_KEY=your_google_ai_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Google Business Profile OAuth (review auto-reply)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.pratisad.scaleopal.com/integrations/google/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_OAUTH_STATE_SECRET=
WEB_APP_ORIGIN=https://pratisad.scaleopal.com

# 0 = no "Sync now" cooldown (testing). Production: 900000
GOOGLE_REVIEWS_MANUAL_SYNC_COOLDOWN_MS=0

E2E_AUTH_BYPASS=false
