# Server
PORT=4000
NODE_ENV=development

# CORS — comma-separated for multiple origins (frontend + Vercel previews)
# Local:  http://localhost:3000
# Prod:   https://pratisad.scaleopal.com
CORS_ORIGIN=http://localhost:3000

# Platform admin allowlist (seeded via npm run db:seed)
PLATFORM_ADMIN_EMAIL=admin@example.com

# Clerk — same application as pratisad-web (use sk_live_ in production)
CLERK_SECRET_KEY=your_clerk_secret_key
# Optional — safety net for Clerk user.created; portal users are provisioned via API
CLERK_WEBHOOK_SIGNING_SECRET=whsec_your_clerk_webhook_secret

# Optional redirect origin (legacy / Clerk dashboard links)
WEB_APP_ORIGIN=http://localhost:3000

# Max cards per print batch (review card inventory)
REVIEW_CARD_BATCH_MAX=500

# Never enable in production
E2E_AUTH_BYPASS=false

# Google Gemini review drafting
GEMINI_API_KEY=your_google_ai_api_key
# Optional — defaults to gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash

# Database
# Local host (Prisma CLI / direct):
DATABASE_URL="postgresql://pratisad_user:pratisad_password@localhost:5432/pratisad_db?schema=public"
# Docker Compose internal:
# DATABASE_URL="postgresql://pratisad_user:pratisad_password@postgres:5432/pratisad_db?schema=public"

# Production VPS only — used by docker-compose.prod.yml
# POSTGRES_PASSWORD=use_a_strong_random_password
